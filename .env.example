# === DevPilot Environment Configuration Example ===

APP_NAME=DevPilot API
APP_VERSION=1.0.0
DEBUG=false

# Server Settings
API_HOST=127.0.0.1
API_PORT=8000

# Auth & Secrets
SESSION_TOKEN=
JWT_SECRET=your-secure-32-character-secret-key-here

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_REMOTE=false
DOCKER_MODE=false

# Database & Cache
DATABASE_URL=sqlite:///devpilot.db
REDIS_URL=redis://localhost:6379

# AI Provider Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
