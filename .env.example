# === Loopix Environment Configuration Example ===

APP_NAME=Loopix API
APP_VERSION=1.0.0
DEBUG=false

# Server Settings
API_HOST=127.0.0.1
API_PORT=8000

# Auth & Secrets
SESSION_TOKEN=
JWT_SECRET=your-secure-32-character-secret-key-here

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_REMOTE=false
DOCKER_MODE=false

# Database & Cache
DATABASE_URL=sqlite:///loopix.db
REDIS_URL=redis://localhost:6379

# AI Provider Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Agent Cost Limits
# Soft advisory — user is prompted to approve continuation above this threshold (default $5.00)
COST_LIMIT_USD=5.00
# Hard ceiling — session is forcibly terminated above this amount, no user override (default $10.00)
LOOPIX_HARD_COST_LIMIT=10.00

# ChromaDB RAG Index Eviction
# Maximum number of workspace ChromaDB indexes to keep in ~/.loopix/chroma/ (default 8)
LOOPIX_MAX_CHROMA_DIRS=8
# Maximum age in days before a ChromaDB index is evicted (default 30)
LOOPIX_CHROMA_MAX_AGE_DAYS=30

# Logging & Monitoring Configuration
LOG_JSON=false
LOG_LEVEL=INFO

